{
  "name": "whatsapp-order-notifier",
  "version": "1.0.0",
  "description": "Sends a WhatsApp notification whenever a new order is inserted into Supabase (Baileys + Supabase Realtime)",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed-session": "node seed-session.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "supabase",
    "realtime",
    "order",
    "notification"
  ],
  "license": "MIT",
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.5": true
  }
}
