# --- WhatsApp ---------------------------------------------------------------
# Your personal number that should receive order notifications.
# Format: country code + number, digits only, no "+", no spaces.
# Example (Pakistan): 92304557141  ->  92304557141
WHATSAPP_NUMBER=923095052227

# --- Optional ---------------------------------------------------------------
# Where the WhatsApp session (auth_info) is stored.
# AUTH_DIR=auth_info

# Baileys internal logger level: silent | fatal | error | warn | info | debug | trace
# LOG_LEVEL=warn

# --- Product shown in the notification --------------------------------------
# Your site sells a single product, so it is not stored on each order row.
# The bot uses these values to build the message (price = unit price x qty).
PRODUCT_NAME=Dr. Rubina Herbal Weight Loss Powder
PRODUCT_PRICE=1999
